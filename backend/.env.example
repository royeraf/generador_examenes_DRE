# Environment Variables Example
# Copy this file to .env and fill in your API keys

# OpenAI API Key for ChatGPT
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key for Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here

# =====================================================
# CONSULTA DNI (RENIEC) - Registro de usuarios
# =====================================================
# Fuente principal (decolecta.com)
RENIEC_API_URL=https://api.decolecta.com/v1/reniec/dni
RENIEC_API_TOKEN=your_reniec_token_here

# Contingencia 1 (api.perudevs.com)
PERUDEVS_DNI_URL=https://api.perudevs.com/api/v1/dni/simple
PERUDEVS_DNI_TOKEN=your_perudevs_token_here

# Contingencia 2 (apiperu.dev)
APIPERU_DNI_URL=https://apiperu.dev/api/dni
APIPERU_DNI_TOKEN=your_apiperu_token_here
