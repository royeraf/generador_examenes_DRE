@startuml c4_contexto_generador
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Diagrama C4 - Nivel 1: Contexto del Sistema\nSistema Generador de Exámenes DRE (LectoSistem y MatSistem)

Person(docente, "Docente", "Usuario que genera exámenes de comunicación y matemática para evaluar estudiantes")
Person(admin, "Administrador", "Usuario que gestiona accesos, docentes y configuraciones del sistema")

System(sistema_dre, "Sistema DRE\n(LectoSistem / MatSistem)", "Sistema web que permite generar exámenes de comprensión lectora y matemáticas basados en desempeños del currículo nacional peruano, utilizando inteligencia artificial")

System_Ext(gemini, "Google Gemini API", "Servicio de IA generativa que procesa prompts y genera contenido de exámenes estructurado")

System_Ext(chatgpt, "OpenAI ChatGPT API", "Servicio alternativo de IA para generación de preguntas y contenido educativo")

Rel(docente, sistema_dre, "Selecciona grado, área, desempeños y genera exámenes", "HTTPS/Browser")
Rel(docente, sistema_dre, "Descarga examen en formato Word o visualiza historial", "HTTPS")
Rel(admin, sistema_dre, "Gestiona usuarios, módulos y configuraciones del sistema", "HTTPS/Browser")

Rel(sistema_dre, gemini, "Envía prompt con desempeños y recibe examen en JSON", "HTTPS/REST API")
Rel(sistema_dre, chatgpt, "Envía prompt con desempeños y recibe examen en JSON", "HTTPS/REST API")

SHOW_LEGEND()

footer Sistema DRE - Diagrama C4 Contexto | Febrero 2026
@enduml
